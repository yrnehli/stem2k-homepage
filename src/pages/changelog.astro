---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Pricing from "../components/Pricing.astro";
import Features from "../components/Features.astro";
import Support from "../components/Support.astro";
import PWA from "../components/PWA.astro";
---

<Layout>
  <div class="min-h-dvh max-w-screen text-white">
    <Nav />
    <div class="flex flex-col items-center justify-center py-12 px-8">
      <div class="max-w-5xl w-full flex flex-col gap-y-8">
        <h1 class="text-3xl font-bold">Changelog</h1>

        <div class="flex flex-col gap-y-2">
          <div>
            <h2 class="text-xl font-bold">1.7.1</h2>
            <p class="text-gray-300">Oct 25, 2026</p>
          </div>
          <ul class="list-disc list-inside pl-2">
            <li>Performance improvements</li>
          </ul>
        </div>

        <div class="flex flex-col gap-y-2">
          <div>
            <h2 class="text-xl font-bold">1.7.0</h2>
            <p class="text-gray-300">Oct 25, 2026</p>
          </div>
          <ul class="list-disc list-inside pl-2">
            <li>UI updates</li>
          </ul>
        </div>

        <div class="flex flex-col gap-y-2">
          <div>
            <h2 class="text-xl font-bold">1.6.2</h2>
            <p class="text-gray-300">Oct 24, 2026</p>
          </div>
          <ul class="list-disc list-inside pl-2">
            <li>Added a clear queue button</li>
          </ul>
        </div>

        <div class="flex flex-col gap-y-2">
          <div>
            <h2 class="text-xl font-bold">1.6.1</h2>
            <p class="text-gray-300">Oct 24, 2026</p>
          </div>
          <ul class="list-disc list-inside pl-2">
            <li>Bug fixes</li>
          </ul>
        </div>

        <div class="flex flex-col gap-y-2">
          <div>
            <h2 class="text-xl font-bold">1.6.0</h2>
            <p class="text-gray-300">Oct 24, 2026</p>
          </div>
          <ul class="list-disc list-inside pl-2">
            <li>Bug fixes</li>
            <li>Press <code>L</code> to toggle lyrics</li>
            <li>Press <code>Q</code> to open and close the queue</li>
            <li>
              Press <code>←</code> / <code>→</code> to seek 5 seconds back or forward
            </li>
            <li>
              Press <code>Shift</code> + <code>←</code> / <code>→</code> to skip to
              the previous or next track
            </li>
            <li>
              Press <code>S</code> to toggle shuffle and <code>R</code> to cycle repeat
              modes
            </li>
            <li>Press <code>H</code> to jump to Home</li>
            <li>
              Press <code>Tab</code> in search to open the actions menu for the highlighted
              result, and <code>Tab</code> again to close it
            </li>
          </ul>
        </div>

        <div class="flex flex-col gap-y-2">
          <div>
            <h2 class="text-xl font-bold">1.5.0</h2>
            <p class="text-gray-300">Oct 23, 2026</p>
          </div>
          <ul class="list-disc list-inside pl-2">
            <li>Shuffle any artist in your library</li>
            <li>Search now finds artists in your library</li>
            <li>Reorder songs in your playlists by dragging</li>
            <li>New “Go to Artist” option when you right-click</li>
            <li>Delete songs from your library when you right-click</li>
            <li>Add songs and albums to playlists from more places</li>
            <li>New Artists tab, so you can browse your library by artist</li>
          </ul>
        </div>

        <div class="flex flex-col gap-y-2">
          <div>
            <h2 class="text-xl font-bold">1.4.3</h2>
            <p class="text-gray-300">Oct 23, 2026</p>
          </div>
          <ul class="list-disc list-inside pl-2">
            <li>
              Shows an indicator next to the most popular tracks on an album
              page
            </li>
          </ul>
        </div>

        <div class="flex flex-col gap-y-2">
          <div>
            <h2 class="text-xl font-bold">1.4.2</h2>
            <p class="text-gray-300">Oct 20, 2026</p>
          </div>
          <ul class="list-disc list-inside pl-2">
            <li>Bug fixes</li>
          </ul>
        </div>

        <div class="flex flex-col gap-y-2">
          <div>
            <h2 class="text-xl font-bold">1.4.1</h2>
            <p class="text-gray-300">Oct 19, 2026</p>
          </div>
          <ul class="list-disc list-inside pl-2">
            <li>Performance improvements</li>
          </ul>
        </div>

        <div class="flex flex-col gap-y-2">
          <div>
            <h2 class="text-xl font-bold">1.4.0</h2>
            <p class="text-gray-300">Oct 17, 2026</p>
          </div>
          <ul class="list-disc list-inside pl-2">
            <li>Performance improvements</li>
          </ul>
        </div>

        <div class="flex flex-col gap-y-2">
          <div>
            <h2 class="text-xl font-bold">1.3.8</h2>
            <p class="text-gray-300">Oct 16, 2026</p>
          </div>
          <ul class="list-disc list-inside pl-2">
            <li>Bug fixes</li>
          </ul>
        </div>

        <div class="flex flex-col gap-y-2">
          <div>
            <h2 class="text-xl font-bold">1.3.7</h2>
            <p class="text-gray-300">Oct 16, 2026</p>
          </div>
          <ul class="list-disc list-inside pl-2">
            <li>Major performance improvements</li>
          </ul>
        </div>

        <div class="flex flex-col gap-y-2">
          <div>
            <h2 class="text-xl font-bold">1.3.6</h2>
            <p class="text-gray-300">May 16, 2026</p>
          </div>
          <ul class="list-disc list-inside pl-2">
            <li>
              Added the ability to choose another country to see content
              specific to your location. This is available under "Region"
              setting of the user dropdown menu.
            </li>
          </ul>
        </div>

        <div class="flex flex-col gap-y-2">
          <div>
            <h2 class="text-xl font-bold">1.3.5</h2>
            <p class="text-gray-300">May 2, 2026</p>
          </div>
          <ul class="list-disc list-inside pl-2">
            <li>Bug fixes</li>
          </ul>
        </div>

        <div class="flex flex-col gap-y-2">
          <div>
            <h2 class="text-xl font-bold">1.3.4</h2>
            <p class="text-gray-300">April 12, 2026</p>
          </div>
          <ul class="list-disc list-inside pl-2">
            <li>
              Enabled the ability to add a password to your stem2k account to
              use for log in
            </li>
          </ul>
        </div>

        <div class="flex flex-col gap-y-2">
          <div>
            <h2 class="text-xl font-bold">1.3.3</h2>
            <p class="text-gray-300">March 21, 2026</p>
          </div>
          <ul class="list-disc list-inside pl-2">
            <li>
              Double clicking a track from the queue will now skip directly to
              that track
            </li>
            <li>
              Added new user dropdown menu, with the ability to send feedback
              (via Feedli)
            </li>
            <li>Changed "Remove" text to "Remove from Playlist"</li>
          </ul>
        </div>

        <div class="flex flex-col gap-y-2">
          <div>
            <h2 class="text-xl font-bold">1.3.2</h2>
            <p class="text-gray-300">February 28, 2026</p>
          </div>
          <ul class="list-disc list-inside pl-2">
            <li>Added "Appears On" section to artist pages</li>
          </ul>
        </div>

        <div class="flex flex-col gap-y-2">
          <div>
            <h2 class="text-xl font-bold">1.3.1</h2>
            <p class="text-gray-300">February 25, 2026</p>
          </div>
          <ul class="list-disc list-inside pl-2">
            <li>Bug fixes</li>
          </ul>
        </div>

        <div class="flex flex-col gap-y-2">
          <div>
            <h2 class="text-xl font-bold">1.3.0</h2>
            <p class="text-gray-300">February 15, 2026</p>
          </div>
          <ul class="list-disc list-inside pl-2">
            <li>Added support for playlist folders</li>
          </ul>
        </div>

        <div class="flex flex-col gap-y-2">
          <div>
            <h2 class="text-xl font-bold">1.2.8</h2>
            <p class="text-gray-300">February 13, 2026</p>
          </div>
          <ul class="list-disc list-inside pl-2">
            <li>
              Fix background colour when scrolling out of bounds (thanks Zsolt)
            </li>
          </ul>
        </div>

        <div class="flex flex-col gap-y-2">
          <div>
            <h2 class="text-xl font-bold">1.2.7</h2>
            <p class="text-gray-300">February 11, 2026</p>
          </div>
          <ul class="list-disc list-inside pl-2">
            <li>Bug fixes</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</Layout>
